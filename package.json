{
  "name": "mechanical-main",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "clean": "rm -rf dist",
    "clone-docs": "DOCS_CONTEXT=docs node scripts/clone-docs.js",
    "clone-user": "DOCS_CONTEXT=user node scripts/clone-docs.js",
    "setup-content": "node scripts/setup-content.js",
    "fix-paths": "node scripts/fix-image-paths.js",
    "generate-nav": "node scripts/generate-nav.js",
    "generate-slug-map": "node scripts/generate-slug-map.js",
    "copy-images": "node scripts/copy-images.js",
    "dev": "npm run setup-content && npm run fix-paths && npm run copy-images && npm run generate-nav && npm run generate-slug-map && astro dev",
    "build": "npm run clone-docs && npm run setup-content && npm run clean && npm run fix-paths && npm run copy-images && npm run generate-nav && npm run generate-slug-map && astro build",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.10",
    "@astrojs/react": "^4.4.2",
    "@astrojs/sitemap": "^3.6.0",
    "@docsearch/css": "^4.3.1",
    "@docsearch/js": "^4.3.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "astro": "^5.15.4",
    "bootstrap": "^5.3.8",
    "classnames": "^2.5.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sass": "^1.93.3",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "fs-extra": "^11.3.2"
  }
}
