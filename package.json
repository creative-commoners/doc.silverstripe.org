{
  "name": "mechanical-main",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "clean": "rm -rf dist",
    "clone-docs": "DOCS_CONTEXT=docs node scripts/clone-docs.js",
    "clone-user": "DOCS_CONTEXT=user node scripts/clone-docs.js",
    "setup-content": "node scripts/setup-content.js",
    "fix-paths": "node scripts/fix-image-paths.js",
    "generate-nav": "node scripts/generate-nav.js",
    "generate-slug-map": "node scripts/generate-slug-map.js",
    "copy-images": "node scripts/copy-images.js",
    "dev": "npm run setup-content && npm run fix-paths && npm run copy-images && npm run generate-nav && npm run generate-slug-map && npm run generate-docs-index && astro dev",
    "build": "npm run clone-docs && npm run setup-content && npm run clean && npm run fix-paths && npm run copy-images && npm run generate-nav && npm run generate-slug-map && npm run generate-docs-index && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "generate-docs-index": "node scripts/generate-docs-index.mjs",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.10",
    "@astrojs/react": "^4.4.2",
    "@astrojs/sitemap": "^3.6.0",
    "@docsearch/css": "^4.3.1",
    "@docsearch/js": "^4.3.1",
    "astro": "^5.15.4",
    "bootstrap": "^5.3.8",
    "cheerio": "^1.1.2",
    "classnames": "^2.5.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sass": "^1.93.3",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@babel/plugin-transform-runtime": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "babel-jest": "^30.2.0",
    "fs-extra": "^11.3.2",
    "gray-matter": "^4.0.3",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0"
  }
}
