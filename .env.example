# Algolia DocSearch Configuration
# Get these values from your Algolia dashboard
PUBLIC_DOCSEARCH_API_KEY=your_api_key_here
PUBLIC_DOCSEARCH_APP_ID=your_app_id_here
PUBLIC_DOCSEARCH_INDEX_DOCS=silverstripe_docs
PUBLIC_DOCSEARCH_INDEX_USER=silverstripe_user

# Site context (docs or user)
DOCS_CONTEXT=docs
