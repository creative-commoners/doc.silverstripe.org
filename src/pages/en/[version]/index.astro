---
import { getCollection } from 'astro:content';
import DocsLayout from '../../../layouts/DocsLayout.astro';
import DocsContent from '../../../components/DocsContent';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
  const allDocs = await getCollection('docs');
  
  // Find all version index files (v5/index.md, v6/index.md, etc.)
  const indexDocs = allDocs.filter(doc => {
    const matches = doc.id.match(/^v(\d+)\/index\.mdx?$/);
    return !!matches;
  });

  const paths = indexDocs.map(doc => {
    const versionMatch = doc.id.match(/^v(\d+)/);
    if (!versionMatch) return null;
    
    return {
      params: { version: versionMatch[1] },
      props: { doc },
    };
  }).filter(Boolean);

  return paths;
}) satisfies GetStaticPaths;

const { doc } = Astro.props;
const { version } = Astro.params;
const { Content, headings } = await doc.render();

// Get frontmatter with defaults
const {
  title,
  introduction,
  icon,
  hideChildren,
} = doc.data;

// Generate page title
const pageTitle = title || `Silverstripe CMS v${version} Documentation`;

// Format headings for TOC
const formattedHeadings = headings
  .filter(h => h.depth > 1 && h.depth <= 3)
  .map(h => ({
    ...h,
    slug: h.slug,
  }));
---

<DocsLayout 
  title={pageTitle} 
  version={version}
  context="docs"
  doc={doc}
  headings={formattedHeadings}
>
  {introduction && (
    <div class="introduction">
      {introduction}
    </div>
  )}
  
  <DocsContent client:load version={version} slug={undefined} docId={doc.id}>
    <Content />
  </DocsContent>
</DocsLayout>

<style>
  .introduction {
    font-size: 1.1rem;
    line-height: 1.6;
    margin-bottom: 2rem;
    color: #555;
  }
</style>
