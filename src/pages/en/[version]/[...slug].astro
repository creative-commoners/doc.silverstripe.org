---
import { getCollection } from 'astro:content';
import DocsLayout from '../../../layouts/DocsLayout.astro';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
  const allDocs = await getCollection('docs');
  
  const paths = allDocs.map(doc => {
    // Extract the slug path from the doc ID
    // Astro Content Collection IDs may include .md/.mdx extensions
    // e.g., "00_Getting_Started/02_Composer.md" or "index.md"
    let id = doc.id
      .replace(/\.(md|mdx)$/, '')  // Remove file extension
      .replace(/\.md$/, '')        // Additional cleanup for .md
      .replace(/\.mdx$/, '');      // Additional cleanup for .mdx
    
    const parts = id.split('/');
    
    // Build slug: remove 'index' parts and join remaining
    const slugParts = parts
      .filter(p => p !== 'index')
      .join('/');
    
    // Default to version 6 for now (will be expanded in future phases)
    const version = '6';
    
    return {
      params: { 
        version, 
        slug: slugParts  // Use empty string for root, not undefined
      },
      props: { doc },
    };
  });
  
  return paths;
}) satisfies GetStaticPaths;

const { doc } = Astro.props;
const { version, slug } = Astro.params;
const { Content, headings } = await doc.render();

// Get frontmatter with defaults
const {
  title,
  introduction,
  icon,
  hideChildren,
} = doc.data;

// Generate page title
const pageTitle = title || doc.id.split('/').pop()?.replace(/_/g, ' ') || 'Documentation';

// Format headings for TOC
const formattedHeadings = headings
  .filter(h => h.depth > 1 && h.depth <= 3)
  .map(h => ({
    ...h,
    slug: h.slug,
  }));
---

<DocsLayout 
  title={pageTitle} 
  version={version}
  context="docs"
  doc={doc}
  headings={formattedHeadings}
>
  {introduction && (
    <div class="introduction">
      {introduction}
    </div>
  )}
  
  <Content />
</DocsLayout>

<style>
  .introduction {
    font-size: 1.1rem;
    line-height: 1.6;
    margin-bottom: 2rem;
    color: #555;
  }
</style>
