---
import { getCollection } from 'astro:content';
import DocsLayout from '../../../layouts/DocsLayout.astro';
import DocsContent from '../../../components/DocsContent';
import ChildrenList from '../../../components/ChildrenList.astro';
import { remarkLanguageAliases } from '../../../utils/remarkPlugins.js';
import remarkChildrenBlocks from '../../../utils/remarkChildrenBlocks.js';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
  const allDocs = await getCollection('docs');
  
  const paths = allDocs.map(doc => {
    // Skip ONLY the root version index files (v5/index.md, v6/index.md)
    // Those are handled by the dedicated index.astro route
    if (doc.id.match(/^v(\d+)\/index\.mdx?$/)) {
      return null;
    }
    
    // Extract version from the doc ID (first path component: v3, v4, v5, v6)
    const idParts = doc.id.split('/');
    const versionMatch = idParts[0]?.match(/^v(\d+)/);
    
    if (!versionMatch) {
      console.warn(`Warning: Could not extract version from doc ID: ${doc.id}`);
      return null;
    }
    
    const version = versionMatch[1];
    
    // Extract slug path, removing version prefix and file extension
    let filePath = doc.id
      .replace(/^v\d+\//, '')  // Remove version prefix
      .replace(/\.(md|mdx)$/, '')  // Remove file extension
      .replace(/\/index$/, '');  // Remove trailing /index (for nested index files like 08_Changelogs/index)
    
    // All paths should have content (empty means root index which we skip)
    if (!filePath) {
      return null;
    }
    
    return {
      params: { 
        version, 
        slug: filePath
      },
      props: { doc },
    };
  }).filter(Boolean);
  
  return paths;
}) satisfies GetStaticPaths;

const { doc } = Astro.props;
const { version, slug } = Astro.params;
const { Content, headings } = await doc.render({
  components: {
    ChildrenList,
  },
});

// Get frontmatter with defaults
const {
  title,
  introduction,
  icon,
  hideChildren,
} = doc.data;

// Generate page title
const pageTitle = title || doc.id.split('/').pop()?.replace(/_/g, ' ') || 'Documentation';

// Format headings for TOC
const formattedHeadings = headings
  .filter(h => h.depth > 1 && h.depth <= 3)
  .map(h => ({
    ...h,
    slug: h.slug,
  }));
---

<DocsLayout 
  title={pageTitle} 
  version={version}
  context="docs"
  doc={doc}
  headings={formattedHeadings}
>
  {introduction && (
    <div class="introduction">
      {introduction}
    </div>
  )}
  
  <DocsContent client:load version={version} slug={slug} docId={doc.id}>
    <Content />
  </DocsContent>
</DocsLayout>

<style>
  .introduction {
    font-size: 1.1rem;
    line-height: 1.6;
    margin-bottom: 2rem;
    color: #555;
  }
</style>
