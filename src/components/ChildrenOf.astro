---
import { getCollection } from 'astro:content';
import type { ChildrenOfOptions } from '../utils/parseChildrenOf';

interface Props {
  options: ChildrenOfOptions;
  currentPath: string;
  version: string;
}

const { options, currentPath, version } = Astro.props;

// Get the current page's parent path
const parentPath = currentPath.substring(0, currentPath.lastIndexOf('/'));

// Get all docs for this version
const allDocs = await getCollection('docs', ({ id }) => id.startsWith(`v${version}/`));

// Filter docs based on options
let children = allDocs.filter(doc => {
  const docPath = doc.id.substring(doc.id.indexOf('/') + 1); // Remove version prefix
  
  // Only get direct children
  if (!docPath.startsWith(parentPath + '/')) {
    return false;
  }

  const relativePath = docPath.substring((parentPath + '/').length);
  
  // Skip if path contains another level
  if (relativePath.includes('/')) {
    return false;
  }

  // Apply folder filter
  if (options.folder) {
    if (!docPath.includes(options.folder)) {
      return false;
    }
  }

  // Apply exclude filter
  if (options.exclude && options.exclude.length > 0) {
    const docName = relativePath.replace(/\/$/, '');
    if (options.exclude.includes(docName)) {
      return false;
    }
  }

  // Apply only filter
  if (options.only && options.only.length > 0) {
    const docName = relativePath.replace(/\/$/, '');
    if (!options.only.includes(docName)) {
      return false;
    }
  }

  return true;
});

// Apply sorting
if (options.reverse) {
  children = children.reverse();
}

// Sort by order in frontmatter, then by title
children = children.sort((a, b) => {
  const orderA = a.data.order ?? Infinity;
  const orderB = b.data.order ?? Infinity;
  
  if (orderA !== orderB) {
    return orderA - orderB;
  }
  
  const titleA = a.data.title || a.id;
  const titleB = b.data.title || b.id;
  return titleA.localeCompare(titleB);
});
---

{children.length > 0 && (
  <div class="children-of">
    {options.asList ? (
      <ul class="children-list">
        {children.map(child => (
          <li key={child.id}>
            <a href={`/en/${version}/${child.slug}/`}>
              {child.data.title || child.slug}
            </a>
            {child.data.summary && (
              <p class="children-summary">{child.data.summary}</p>
            )}
          </li>
        ))}
      </ul>
    ) : (
      <div class="children-grid">
        {children.map(child => (
          <a 
            key={child.id}
            href={`/en/${version}/${child.slug}/`}
            class="children-card"
          >
            <h4>{child.data.title || child.slug}</h4>
            {child.data.summary && (
              <p>{child.data.summary}</p>
            )}
          </a>
        ))}
      </div>
    )}
  </div>
)}

<style>
  .children-of {
    margin: 2rem 0;
  }

  .children-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .children-list li {
    margin: 1rem 0;
  }

  .children-list a {
    display: block;
    font-weight: 500;
    text-decoration: none;
    color: #0066cc;
    transition: color 0.2s ease;
  }

  .children-list a:hover {
    color: #0052a3;
    text-decoration: underline;
  }

  .children-summary {
    margin: 0.5rem 0 0 0;
    font-size: 0.9rem;
    color: #666;
  }

  .children-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 1rem;
  }

  .children-card {
    display: block;
    padding: 1.5rem;
    border: 1px solid #e0e0e0;
    border-radius: 0.375rem;
    text-decoration: none;
    color: inherit;
    transition: all 0.2s ease;
  }

  .children-card:hover {
    border-color: #0066cc;
    box-shadow: 0 2px 8px rgba(0, 102, 204, 0.1);
  }

  .children-card h4 {
    margin: 0 0 0.5rem 0;
    color: #0066cc;
    font-size: 1.1rem;
  }

  .children-card p {
    margin: 0;
    color: #666;
    font-size: 0.9rem;
  }

  @media (max-width: 768px) {
    .children-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
