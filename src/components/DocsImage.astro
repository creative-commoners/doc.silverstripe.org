---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const { 
  src, 
  alt, 
  width, 
  height,
  title,
  class: className = '',
  loading = 'lazy'
} = Astro.props;

// Determine if the image is remote (HTTP/HTTPS) or local
const isRemote = typeof src === 'string' && src.startsWith('http');
---

{isRemote ? (
  <img 
    src={src} 
    alt={alt}
    {title}
    class={className}
    loading={loading}
    width={width}
    height={height}
  />
) : (
  <Image 
    src={src}
    alt={alt}
    {title}
    class={className}
    loading={loading}
    width={typeof width === 'string' ? parseInt(width) : width}
    height={typeof height === 'string' ? parseInt(height) : height}
  />
)}

<style>
  img {
    max-width: 100%;
    height: auto;
    display: block;
    border-radius: 0.25rem;
  }
</style>
